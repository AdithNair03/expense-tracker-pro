# Copy to .env for local development:  Copy-Item .env.example .env
# Never commit .env. In Docker/Kubernetes these come from env vars and Secrets instead.

FLASK_APP=wsgi.py
FLASK_CONFIG=development        # development | production | testing
SECRET_KEY=change-me-to-a-long-random-string

# Database: leave DB_HOST empty to use local SQLite (dev.sqlite3).
# For MySQL (Docker / AWS RDS) set these instead:
DB_HOST=
DB_PORT=3306
DB_NAME=expense_tracker
DB_USER=expense
DB_PASSWORD=

DEFAULT_CURRENCY=INR
SESSION_COOKIE_SECURE=0         # set 1 behind HTTPS
RATELIMIT_STORAGE_URI=memory:// # redis://redis:6379 in later phases
SHOW_DEMO_LOGIN=1               # shows demo credentials on the login page
LOG_LEVEL=INFO
